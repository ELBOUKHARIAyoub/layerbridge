<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="6.0" ExtensionBundleId="com.layerbridge.panel" ExtensionBundleVersion="0.1.0" ExtensionBundleName="LayerBridge"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.layerbridge.panel.main" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[0.0,99.9]" />
      <Host Name="ILST" Version="[0.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0" /></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.layerbridge.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>LayerBridge</Menu>
          <Geometry>
            <Size><Width>260</Width><Height>200</Height></Size>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-23.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-23.png</Icon>
            <Icon Type="RollOver">./icons/icon-23.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-23.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
