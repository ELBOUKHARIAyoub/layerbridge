{
  "id": "com.layerbridge.ps",
  "name": "LayerBridge",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "PS", "minVersion": "24.2.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "com.layerbridge.ps.panel",
      "label": { "default": "LayerBridge" },
      "minimumSize": { "width": 230, "height": 200 }
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin-icon.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://127.0.0.1:61804", "ws://localhost:61804"] }
  }
}
